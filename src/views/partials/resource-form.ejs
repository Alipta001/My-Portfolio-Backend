<%- include('./header') %>
<header class="page-head"><div><p class="eyebrow">Content editor</p><h1><%= record._id ? 'Edit' : 'New' %> <%= resource %></h1></div></header><form class="editor" method="post" enctype="multipart/form-data" action="/admin/<%= resource %><%= record._id ? '/' + record._id + '?_method=PUT' : '' %>"><% fields.forEach(field => { const value = record[field]; const isArray = Array.isArray(value); %><label><%= field %><% if (['desc','description','message','tech','tools','features','tags'].includes(field)) { %><textarea name="<%= field %>" rows="<%= ['tech','tools','features','tags'].includes(field) ? 3 : 5 %>" placeholder="Arrays: one item per line"><%= isArray ? value.join('\n') : (value || '') %></textarea><% } else if (field === 'image') { %><input type="file" name="image" accept="image/*"><input name="image" value="<%= value || '' %>" placeholder="Or image URL"><% } else if (field === 'published') { %><input type="checkbox" name="published" value="true" <%= value !== false ? 'checked' : '' %>><% } else { %><input name="<%= field %>" value="<%= value || '' %>" <%= field === 'title' || field === 'category' || field === 'role' || field === 'degree' ? 'required' : '' %>><% } %></label><% }) %><button>Save record</button></form>
<%- include('./footer') %>
