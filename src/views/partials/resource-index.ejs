<%- include('./header') %>
<header class="page-head"><div><p class="eyebrow">Content</p><h1><%= resource %></h1></div><a class="button" href="/admin/<%= resource %>/new">Add record</a></header><div class="table-wrap"><table><thead><tr><th>Record</th><th>Details</th><th>Actions</th></tr></thead><tbody><% records.forEach(record => { %><tr><td><strong><%= record.title || record.category || record.role || record.degree || record._id %></strong></td><td class="details"><% Object.entries(record).filter(([key]) => !['_id', '__v', 'createdAt', 'updatedAt'].includes(key)).forEach(([key, value]) => { %><div><strong><%= key %>:</strong> <%= Array.isArray(value) ? value.join(', ') : value %></div><% }) %></td><td><a href="/admin/<%= resource %>/<%= record._id %>/edit">Edit</a><form method="post" action="/admin/<%= resource %>/<%= record._id %>?_method=DELETE"><button class="danger">Delete</button></form></td></tr><% }) %></tbody></table></div>
<%- include('./footer') %>
