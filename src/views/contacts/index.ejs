<%- include('../partials/header') %>
<header class="page-head"><div><p class="eyebrow">Inbox</p><h1>Contact messages</h1></div></header><div class="table-wrap"><table><thead><tr><th>From</th><th>Message</th><th>Status</th><th>Actions</th></tr></thead><tbody><% contacts.forEach(contact => { const isRead = contact.isRead ?? contact.read ?? false; %><tr class="<%= isRead ? '' : 'unread' %>"><td><strong><%= contact.name %></strong><br><a href="mailto:<%= contact.email %>"><%= contact.email %></a></td><td><%= contact.message %></td><td><%= isRead ? 'Read' : 'Unread' %></td><td><form method="post" action="/admin/contacts/<%= contact._id %>/read"><input type="hidden" name="read" value="<%= String(!isRead) %>"><button><%= isRead ? 'Mark unread' : 'Mark read' %></button></form><form method="post" action="/admin/contacts/<%= contact._id %>?_method=DELETE"><button class="danger">Delete</button></form></td></tr><% }) %></tbody></table></div>
<%- include('../partials/footer') %>
